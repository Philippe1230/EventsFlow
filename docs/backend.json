
{
  "entities": {
    "Tenant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tenant",
      "type": "object",
      "description": "Represents an organization or 'tenant' within the Arraial PDV system. All data, such as products and orders, is isolated and scoped to a specific tenant.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "type": "object",
      "description": "A specific event within a tenant. Contains configuration, status, and links to products and team.",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["rascunho", "ativo", "finalizado"]
        },
        "members": {
          "type": "object",
          "description": "Map of user IDs to roles for this specific event."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "name", "status", "createdAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "type": "object",
      "description": "A supplier or stall (barraca) linked to an event.",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "name": { "type": "string" },
        "responsibleName": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "totalActualRevenue": { "type": "number", "default": 0 },
        "totalActualCost": { "type": "number", "default": 0 },
        "totalActualProfit": { "type": "number", "default": 0 }
      },
      "required": ["id", "eventId", "name"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["own", "supplier"] },
        "supplierId": { "type": "string" },
        "supplierUnitCost": { "type": "number" },
        "plannedQuantity": { "type": "number" },
        "active": { "type": "boolean" },
        "soldQuantity": { "type": "number", "default": 0 }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/tenants/{tenantId}/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "description": "Specific events under a tenant."
        }
      },
      {
        "path": "/tenants/{tenantId}/events/{eventId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "description": "Products specific to an event."
        }
      },
      {
        "path": "/tenants/{tenantId}/events/{eventId}/suppliers/{supplierId}",
        "definition": {
          "entityName": "Supplier",
          "description": "Suppliers/Stalls specific to an event."
        }
      },
      {
        "path": "/tenants/{tenantId}/events/{eventId}/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "description": "Orders specific to an event."
        }
      }
    ]
  }
}
