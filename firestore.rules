
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário é membro do tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/tenants/$(tenantId)).data.members[request.auth.uid] != null);
    }

    // Regras para Perfis de Usuário
    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Permite que usuários gerenciem suas próprias associações a tenants
      match /memberships/{membershipId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Regras para Tenancy (Organizações)
    match /tenants/{tenantId} {
      // Permite criação se o usuário estiver logado (o primeiro a criar se torna dono)
      allow create: if isSignedIn();
      // Leitura e escrita apenas para membros
      allow read, write: if isTenantMember(tenantId);
      
      // Regra recursiva para todas as subcoleções (produtos, pedidos, etc.)
      match /{allPaths=**} {
        allow read, write: if isTenantMember(tenantId);
      }
    }

    // Contadores de pedidos por tenant
    match /tenant_counters/{tenantId} {
      allow read, write: if isTenantMember(tenantId);
    }
  }
}
