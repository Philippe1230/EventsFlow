
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Permitir acesso para o tenant padrão e suas subcoleções
    match /tenants/{tenantId} {
      allow read, write: if isSignedIn();
      
      // Regra recursiva para todas as subcoleções dentro de um tenant (produtos, pedidos, etc.)
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /tenant_counters/{tenantId} {
      allow read, write: if isSignedIn();
    }

    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
