
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções de Ajuda
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'flowevents@gmail.com';
    }

    function isOwnerOfProfile(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verifica se o usuário é membro de um tenant específico
    function isMember(tenantId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.members[request.auth.uid] != null
      );
    }

    // Verifica papel específico no tenant
    function hasRole(tenantId, role) {
      let member = get(/databases/$(database)/documents/tenants/$(tenantId)).data.members[request.auth.uid];
      return isSuperAdmin() || (member != null && (member == role || member.role == role));
    }

    // --- REGRAS DE COLEÇÕES ---

    // Perfis de Usuário
    match /userProfiles/{userId} {
      allow read: if isOwnerOfProfile(userId) || isSuperAdmin();
      allow write: if isOwnerOfProfile(userId);
      allow list: if isSuperAdmin();
      
      match /memberships/{membershipId} {
        allow read, write: if isOwnerOfProfile(userId);
      }
    }

    // Organizações (Tenants)
    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow list: if isSuperAdmin();
      allow read: if isMember(tenantId);
      allow update: if hasRole(tenantId, 'owner');
      
      // Regras específicas de Pedidos para isolamento de Caixas
      match /orders/{orderId} {
        allow create: if isMember(tenantId);
        // Apenas Donos, Super Admin ou o próprio autor do pedido pode ler
        allow read: if isSuperAdmin() || hasRole(tenantId, 'owner') || (isSignedIn() && resource.data.userId == request.auth.uid);
        
        match /orderItems/{itemId} {
          allow read: if isSuperAdmin() || hasRole(tenantId, 'owner') || (isSignedIn() && get(/databases/$(database)/documents/tenants/$(tenantId)/orders/$(orderId)).data.userId == request.auth.uid);
        }
      }

      // Regras para outros recursos do tenant
      match /products/{productId} {
        allow read: if isMember(tenantId);
        allow write: if hasRole(tenantId, 'owner');
      }

      match /{allPaths=**} {
        allow read: if isMember(tenantId);
        allow write: if isMember(tenantId);
      }
    }

    // Contadores
    match /tenant_counters/{tenantId} {
      allow read, write: if isMember(tenantId);
    }

    // Bloqueio padrão
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
