
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções de Ajuda
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'flowevents@gmail.com';
    }

    function isOwnerOfProfile(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verifica se o usuário é membro de um tenant específico
    function isMember(tenantId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.members[request.auth.uid] != null
      );
    }

    // Verifica papel específico no tenant
    function hasRole(tenantId, role) {
      let member = get(/databases/$(database)/documents/tenants/$(tenantId)).data.members[request.auth.uid];
      return isSuperAdmin() || (member != null && (member == role || member.role == role));
    }

    // Verifica se é membro de um evento específico
    function isEventMember(tenantId, eventId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        hasRole(tenantId, 'owner') ||
        get(/databases/$(database)/documents/tenants/$(tenantId)/events/$(eventId)).data.members[request.auth.uid] != null
      );
    }

    // --- REGRAS DE COLEÇÕES ---

    match /userProfiles/{userId} {
      allow read: if isOwnerOfProfile(userId) || isSuperAdmin();
      allow write: if isOwnerOfProfile(userId);
      allow list: if isSuperAdmin();
      
      match /memberships/{membershipId} {
        allow read, write: if isOwnerOfProfile(userId);
      }
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow list: if isSuperAdmin();
      allow read: if isMember(tenantId);
      allow update: if hasRole(tenantId, 'owner');
      
      // Coleção de Eventos
      match /events/{eventId} {
        allow read: if isMember(tenantId);
        allow write: if hasRole(tenantId, 'owner');

        match /products/{productId} {
          allow read: if isEventMember(tenantId, eventId);
          allow write: if hasRole(tenantId, 'owner');
        }

        match /suppliers/{supplierId} {
          allow read: if isEventMember(tenantId, eventId);
          allow write: if hasRole(tenantId, 'owner');
        }

        match /orders/{orderId} {
          allow create: if isEventMember(tenantId, eventId);
          allow read: if isEventMember(tenantId, eventId);
        }
      }

      match /products/{productId} {
        allow read: if isMember(tenantId);
        allow write: if hasRole(tenantId, 'owner');
      }

      match /orders/{orderId} {
        allow create: if isMember(tenantId);
        allow read: if isSuperAdmin() || hasRole(tenantId, 'owner') || (resource.data.userId == request.auth.uid);
      }
    }

    match /tenant_counters/{tenantId} {
      allow read, write: if isMember(tenantId);
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
