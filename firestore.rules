
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário é membro do tenant (fallback via get)
    function isMember(tenantId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.members[request.auth.uid] != null;
    }

    // Regras para Perfis de Usuário e Memberships
    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /memberships/{membershipId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Regras para Tenancy (Organizações)
    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read, write: if isSignedIn() && (resource == null || resource.data.members[request.auth.uid] != null);
      
      // Subcoleções (produtos, pedidos, etc.)
      match /{allPaths=**} {
        // Permite acesso se o documento tiver o mapa de membros denormalizado (Independência de Autorização)
        // Ou se o usuário for membro via verificação no documento pai
        allow read, write: if isSignedIn() && (
          (resource != null && resource.data.tenantMembers[request.auth.uid] != null) ||
          (request.resource != null && request.resource.data.tenantMembers[request.auth.uid] != null) ||
          isMember(tenantId)
        );
      }
    }

    // Contadores de pedidos por tenant
    match /tenant_counters/{tenantId} {
      allow read, write: if isSignedIn() && isMember(tenantId);
    }
  }
}
