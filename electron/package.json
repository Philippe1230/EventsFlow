{
  "name": "flow-events-pdv",
  "version": "1.0.0",
  "description": "Flow Events PDV - Sistema de Ponto de Venda",
  "author": "Flow Events",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "42.3.2"
  },
  "build": {
    "appId": "com.flowevents.pdv",
    "productName": "Flow Events PDV",
    "asar": true,
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "package.json",
      "preload.js",
      "icons/icons/win/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "../public/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flow Events PDV"
    }
  }
}